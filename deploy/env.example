# Copy to /opt/gusto/apps/api/.env on the server (never committed).
# Password = GUSTO_DB_PASSWORD from /opt/gusto/.env (docker compose reads that one).
DATABASE_URL=postgresql://gusto:PASSWORD@localhost:4780/gusto?schema=public
REDIS_URL=redis://localhost:4782
PORT=4783
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_PHONES=
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TEMP until launch (see memory/deployment notes): relaxed limiter + test bypass.
OTP_MAX_REQUESTS_PER_WINDOW=1000
OTP_REQUEST_WINDOW=60
OTP_TEST_CODE=000000
OTP_TEST_PHONES=
